{
  "name": "magpie",
  "private": true,
  "version": "0.1.18",
  "type": "module",
  "license": "MIT",
  "homepage": "https://wolves.ink",
  "repository": {
    "type": "git",
    "url": "https://github.com/wolvesdotink/magpie.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:mac": "bash scripts/build-macos.sh",
    "build:mac:dmg": "bash scripts/build-macos.sh",
    "build:mac:release": "bash scripts/build-macos.sh --universal --notarize --updater",
    "bump:patch": "bash scripts/bump.sh patch",
    "bump:minor": "bash scripts/bump.sh minor",
    "bump:major": "bash scripts/bump.sh major",
    "bump:patch:beta": "bash scripts/bump.sh patch --beta",
    "bump:minor:beta": "bash scripts/bump.sh minor --beta",
    "bump:major:beta": "bash scripts/bump.sh major --beta",
    "bump:beta": "bash scripts/bump.sh beta",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "bun run rust:test",
    "verify": "bun run rust:fmt:check && bun run rust:clippy && bun run typecheck && bun run lint && bun run format:check && bun run rust:test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-global-shortcut": "^2.2.0",
    "@tauri-apps/plugin-notification": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.2.0",
    "@tauri-apps/plugin-store": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.2.0",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tauri-apps/cli": "^2.5.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.3.1",
    "vue-tsc": "^2.2.8"
  }
}
